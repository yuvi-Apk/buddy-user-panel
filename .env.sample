# Copy this file to .env and change what you need. .env is not committed.
# VITE_* values are built into the app, so anyone can read them in the browser.

# Where the backend's API lives: a path on the same site, or a full URL.
VITE_API_BASE_URL=/api/v1

# The Google OAuth client ID (Google Cloud → Credentials → OAuth client, type "Web application").
# Add it to the backend's GOOGLE_CLIENT_IDS too. Under "Authorized redirect URIs" add
# http://localhost:5173/auth/google/callback (and the same path on every site the app runs on).
VITE_GOOGLE_CLIENT_ID=

# Where `pnpm dev` and `pnpm preview` forward /api (your local backend). Not sent to the browser.
API_PROXY_TARGET=http://localhost:4000
