# Every env variable the user app reads. Copy the ones you need into .env.local (never committed).
# VITE_* values end up in the browser bundle, where anyone can read them: never put a secret here.

# Where the backend's API lives: a path on the same site, or a full https:// URL.
# In development keep /api/v1: the Vite dev server forwards /api to API_PROXY_TARGET.
VITE_API_BASE_URL=/api/v1

# Dev server only (not sent to the browser): where `pnpm dev` and `pnpm preview` forward /api.
API_PROXY_TARGET=http://localhost:4000
