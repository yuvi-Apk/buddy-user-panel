{
  // Config files, tooling/ and everything in tests/. Tests import app code from src/, so the DOM
  // types and JSX are available here too.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "types": ["node", "vite/client", "vite-plugin-pwa/react"],
    "paths": { "@/*": ["./src/*"], "@tests/*": ["./tests/*"] },

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedSideEffectImports": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    // Config files import each other with ".ts" (Vite's native config loader needs the extension).
    "allowImportingTsExtensions": true,

    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "pwa-assets.config.ts",
    "tests",
    "tooling"
  ]
}
